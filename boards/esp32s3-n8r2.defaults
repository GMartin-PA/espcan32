# esp32s3-n8r2 — 8 MB flash, 2 MB quad PSRAM
#
# Overlay on sdkconfig.defaults. Build with:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/esp32s3-n8r2.defaults" build

# --- flash ---------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# --- PSRAM ---------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
