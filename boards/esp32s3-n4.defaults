# esp32s3-n4 — 4 MB flash, no PSRAM
#
# Overlay on sdkconfig.defaults. Build with:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/esp32s3-n4.defaults" build

# --- flash ---------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- PSRAM ---------------------------------------------------------------
# No PSRAM on this module. ringbuf falls back to internal RAM; the rings are
# ~30 KB, so nothing is lost but the headroom.
CONFIG_SPIRAM=n

